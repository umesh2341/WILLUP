    "output": {
      "extractedData": {
        "certType": "Study Certificate",
        "requiredDocs": ["ID Card", "Department NOC"]
      },
      "severity": "NA",
      "isDuplicate": false,
      "missingInfo": ["ID Card", "Department NOC"]
    }
  },
  {
    "id": "cert_policy_conflict_unrecognized",
    "description": "Certificate request with unrecognized document type creating a policy conflict",
