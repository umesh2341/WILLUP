[
  {
    "id": "cert_bonafide_success",
    "description": "Standard Bonafide Certificate request",
    "match": {
      "exact": "I want to apply for a Bonafide Certificate.",
      "keywords": ["Bonafide Certificate"]
    },
    "output": {
      "extractedData": {
        "certType": "Bonafide Certificate",
        "requiredDocs": ["ID Card", "Fee Receipt", "Application Form"]
      },
      "severity": "NA",
      "isDuplicate": false,
      "missingInfo": ["ID Card", "Fee Receipt", "Application Form"]
    }
  },
  {
    "id": "cert_studies_conduct_success",
    "description": "Study certificate and conduct certificate request",
    "match": {
