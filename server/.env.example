# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Database Connection URLs
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Server Settings
PORT=5000
NODE_ENV=development

# Gemini AI Configuration (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# RAG Embedding Configuration
# We use @huggingface/transformers to run a local embedding model offline (no API key needed).
# Expected dimension: 384
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Mock LLM for offline/zero-token testing
MOCK_LLM=true

# Deterministic Fixture Test Mode
# When set to true, skips live LLM API calls in chatAgent, categoryAgent, laboratoryAgent,
# certificateAgent, hostelAgent, and grievanceAgent and returns schema-correct fixture responses.
# Must be true for fixture-based verification passes to run reliably without live LLM calls.
TEST_MODE=false
